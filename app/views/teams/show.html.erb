<% content_for :title, @team_member.name %>

<div class="container py-5">
  <% if notice %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Team Profiles", teams_path %></li>
          <li class="breadcrumb-item active" aria-current="page"><%= @team_member.name %></li>
        </ol>
      </nav>

      <div class="card">
        <div class="card-body">
          <div class="row">
            <div class="col-md-4 text-center">
              <% if @team_member.photo.present? %>
                <img src="<%= @team_member.photo %>" class="img-fluid rounded-circle mb-3" alt="<%= @team_member.name %>" style="max-width: 200px; height: 200px; object-fit: cover;">
              <% else %>
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 200px; height: 200px;">
                  <i class="bi bi-person-circle" style="font-size: 6rem; color: #ccc;"></i>
                </div>
              <% end %>
              
              <% if @team_member.social_links.present? %>
                <div class="social-links">
                  <% @team_member.social_links.each do |platform, link| %>
                    <% if link.present? %>
                      <a href="<%= link %>" target="_blank" class="me-3">
                        <i class="bi bi-<%= platform %>" style="font-size: 1.5rem;"></i>
                      </a>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
            
            <div class="col-md-8">
              <h1 class="card-title"><%= @team_member.name %></h1>
              <h5 class="text-muted mb-3"><%= @team_member.role %></h5>
              
              <% if @team_member.bio.present? %>
                <div class="bio-content">
                  <%= simple_format(@team_member.bio) %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="card-footer bg-transparent">
          <%= link_to "Edit Profile", edit_team_path(@team_member), class: "btn btn-outline-danger me-2" %>
          <%= link_to "Delete Profile", team_path(@team_member), method: :delete, 
                      data: { confirm: "Are you sure you want to delete this team member?" }, 
                      class: "btn btn-outline-secondary me-2" %>
          <%= link_to "Back to Team", teams_path, class: "btn btn-secondary" %>
        </div>
      </div>
    </div>
  </div>
</div>