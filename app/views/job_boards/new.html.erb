          <li class="breadcrumb-item"><%= link_to "Job Board", job_boards_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Post New Job</li>
        </ol>
      </nav>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title mb-0">Post New Job</h2>
        </div>
        <div class="card-body">
