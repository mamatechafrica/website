<% content_for :title, "Edit Post" %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Community", community_path %></li>
          <li class="breadcrumb-item"><%= link_to @post.title, @post %></li>
          <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
      </nav>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title mb-0">Edit Post</h2>
        </div>
        <div class="card-body">
          <%= form_with(model: @post, local: true, class: "row g-3") do |form| %>
            <% if @post.errors.any? %>
              <div class="col-12">
                <div class="alert alert-danger" role="alert">
                  <h5>Please fix the following errors:</h5>
                  <ul class="mb-0">
                    <% @post.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>

            <div class="col-12">
              <%= form.label :title, class: "form-label" %>
              <%= form.text_field :title, class: "form-control" %>
            </div>

            <div class="col-12">
              <%= form.label :author, class: "form-label" %>
              <%= form.text_field :author, class: "form-control" %>
            </div>

            <div class="col-12">
              <%= form.label :content, class: "form-label" %>
              <%= form.text_area :content, class: "form-control", rows: 8 %>
            </div>

            <div class="col-12">
              <div class="form-check">
                <%= form.check_box :published, class: "form-check-input" %>
                <%= form.label :published, "Published", class: "form-check-label" %>
              </div>
            </div>

            <div class="col-12">
              <%= form.submit "Update Post", class: "btn btn-danger me-2" %>
              <%= link_to "View Post", @post, class: "btn btn-outline-danger me-2" %>
              <%= link_to "Cancel", @post, class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
